<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Remove trailing slash (ex: /respira-preta/ → /respira-preta)
	# Evita que o Apache processe como diretório físico e retorne 403
	RewriteCond %{REQUEST_URI} ^(.+)/$
	RewriteRule ^ %1 [R=301,L]

	# SPA fallback: serve index.html para tudo que não é arquivo físico
	RewriteRule ^index\.html$ - [L]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
	Header set X-Powered-By "Hostinger Horizons"

	# Cache everything on CDN by default
	Header set Cache-Control "public, s-maxage=604800, max-age=0"

	# Cache in browser all assets
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=604800"
	</If>
</IfModule>
